{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "functions": {
    "api/render.js": {
      "includeFiles": ".prerender/**"
    }
  },
  "redirects": [
    { "source": "/downloads/jk-hiphop.apk", "destination": "https://github.com/radiodeluxe/webradiodeluxe/releases/download/android-v1.2.0/JK-HipHop.apk", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/programacao/index.html", "destination": "/programacao", "permanent": true },
    { "source": "/sobre/index.html", "destination": "/sobre", "permanent": true },
    { "source": "/contato/index.html", "destination": "/contato", "permanent": true },
    { "source": "/privacidade/index.html", "destination": "/privacidade", "permanent": true },
    { "source": "/termos/index.html", "destination": "/termos", "permanent": true },
    { "source": "/editorial/index.html", "destination": "/editorial", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/render?page=/" },
    { "source": "/programacao", "destination": "/api/render?page=/programacao" },
    { "source": "/sobre", "destination": "/api/render?page=/sobre" },
    { "source": "/contato", "destination": "/api/render?page=/contato" },
    { "source": "/privacidade", "destination": "/api/render?page=/privacidade" },
    { "source": "/termos", "destination": "/api/render?page=/termos" },
    { "source": "/editorial", "destination": "/api/render?page=/editorial" },
    { "source": "/llms.txt", "destination": "/api/render?page=/llms.txt" },
    { "source": "/aplicativo", "destination": "/aplicativo/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/aplicativo/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/404.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ]
}
