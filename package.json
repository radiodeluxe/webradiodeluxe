{
  "name": "webradiodeluxe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "build:vercel": "npm run build && npm run verify:seo && node scripts/prepare-vercel.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:server": "node --test tests/*.test.mjs",
    "verify:seo": "node scripts/verify-seo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
